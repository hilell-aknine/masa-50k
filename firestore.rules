rules_version = '2';

// המסע ל-50K · כללי אבטחה
//
// עיקרון: נכשל-סגור. הכלל האחרון חוסם כל מה שלא הותר במפורש למעלה.
// תפקיד וסטטוס גישה נשמרים במסמך הפרופיל, ומשתמש לא יכול לגעת בהם.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- עזרים ----------
    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && me().role == 'admin';
    }

    // גישה פעילה = מותר לצרוך תוכן
    // access_until (בקשת אוריאן 08.09): גישה חינם מוגבלת בזמן ליזמים
    // שהיא מלווה. ריק = ללא הגבלה. עבר = כאילו אין גישה.
    // נאכף כאן ולא רק בממשק, אחרת מספיק לרענן כדי לעקוף.
    function notExpired() {
      return me().get('access_until', null) == null
          || request.time < me().access_until;
    }

    function hasAccess() {
      return signedIn()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && me().access == 'active'
        && (me().role == 'admin' || notExpired());
    }

    // השדות שמשתמש רגיל לעולם לא משנה בעצמו
    // access_until חייב להיות כאן, אחרת תלמידה מאריכה לעצמה את הגישה
    // audience נמצא כאן כי הוא קובע איזו חוויה נטענת (פרימיום = בלי שיווק).
    // בלי ההקפאה הזו מנוי היה מסמן את עצמו פרימיום ומעלים לעצמו את
    // מסך התשלום. רק מנהלת משנה קהל.
    function keepsProtectedFields() {
      return request.resource.data.role   == resource.data.role
          && request.resource.data.access == resource.data.access
          && request.resource.data.get('access_until', null) == resource.data.get('access_until', null)
          && request.resource.data.get('audience', 'subscriber') == resource.data.get('audience', 'subscriber');
    }

    // ---------- פרופילים ----------
    match /profiles/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();

      // יצירה עצמית בהרשמה: תמיד תלמיד, לעולם לא אדמין.
      // גישה פעילה מותרת רק אם קיימת הזמנה עם המייל הזה, שרק מנהל יכול ליצור.
      // ככה רשימת ההזמנות עובדת באמת בלי פונקציות ענן, ובלי לתת למשתמש
      // לפתוח גישה לעצמו. האכיפה בצד השרת.
      allow create: if request.auth.uid == uid
                    && request.resource.data.role == 'student'
                    && (
                         request.resource.data.access == 'pending'
                         || (
                              request.resource.data.access == 'active'
                              && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
                            )
                       )
                    // קהל פרימיום נפתח רק למי שאוריאן הזמינה בשמה.
                    // הרשמה עצמית שתנסה להיוולד 'premium' תיחסם כאן.
                    && (
                         request.resource.data.get('audience', 'subscriber') == 'subscriber'
                         || exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
                       );

      // עדכון עצמי: שם וטלפון בלבד. תפקיד וגישה מוקפאים.
      allow update: if (request.auth.uid == uid && keepsProtectedFields())
                    || isAdmin();

      allow delete: if isAdmin();
    }

    // ---------- התקדמות בקורס ----------
    match /progress/{uid}/stations/{stationId} {
      allow read, write: if request.auth.uid == uid && hasAccess();
      allow read:        if isAdmin();
    }

    // ---------- הערות פרטיות ----------
    // פרטי לחלוטין. גם אדמין לא רואה. החלטה מכוונת, לא פספוס.
    // hasAccess נדרש גם כאן: בלעדיו מי שנתקע ב-pending יכול לכתוב למסד
    // דרך ה-API בלי לעבור את השער, ולשרוף את תקרת הכתיבות היומית של Spark.
    match /notes/{uid}/stations/{stationId} {
      allow read, write: if request.auth.uid == uid && hasAccess();
    }

    // ---------- הזמנות ----------
    // הלל מזין מייל, נוצרת הזמנה, ומי שנרשם עם אותו מייל מקבל גישה.
    // רק מנהל יוצר ומנהל הזמנות.
    // משתמש מחובר רשאי לבדוק אך ורק אם קיימת הזמנה עבור המייל שלו עצמו,
    // ולא לראות את הרשימה כולה.
    match /invites/{email} {
      allow read:  if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // ---------- הגדרות אתר ----------
    // מסמך יחיד (settings/site) עם קישור "השארת פרטים לתהליך עסקי" וכד'.
    // כל מחובר רשאי לקרוא כדי להציג את הכפתור בסרגל הניווט. רק מנהל כותב.
    match /settings/{doc} {
      allow read:  if signedIn();
      allow write: if isAdmin();
    }

    // ---------- שאלות לאוריאן ----------
    // תלמידה רואה אך ורק את השאלות שהיא עצמה שלחה.
    // אין שום מסלול שבו תלמידה רואה שאלה של מישהי אחרת — גם לא "מפורסמת".
    // השאלות נצפות ונענות אך ורק מדשבורד הניהול. החלטת הלל 07.09.
    match /questions/{qid} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.uid == request.auth.uid);

      allow create: if hasAccess()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.answer == null
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 4
                    && request.resource.data.body.size() < 1200;

      allow update, delete: if isAdmin();
    }

    // ---------- תגובות פומביות בתחנה ----------
    // החלטת הלל 08.09: שני שדות נפרדים. `/notes` נשאר פרטי לחלוטין
    // (גם מאדמין), וכאן יושבת התיבה שכולן רואות, ליצירת קהילתיות.
    // מי שרוצה להתייעץ בשקט לא נאלצת לעשות את זה מול הקבוצה.
    match /comments/{cid} {
      // כל מי שגישתה פעילה רואה את התגובות. זה כל הרעיון.
      allow read: if hasAccess() || isAdmin();

      // כותבת רק בשם עצמה, בלי לזייף מחברת אחרת, ובאורך שפוי.
      allow create: if hasAccess()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.stationId is int
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 1
                    && request.resource.data.body.size() < 1000;

      // עריכה אסורה לכולם. תגובה משתנה אחרי שנקראה היא בעיה.
      allow update: if false;

      // מחיקה: אוריאן מורידה כל תגובה, וכל אחת מוחקת את שלה.
      allow delete: if isAdmin() || resource.data.uid == request.auth.uid;
    }

    // ---------- הפניות · "חבר מביא חבר" ----------
    // הבעיה שזה פותר: הספירה נשענה על שאילתה מול profiles, וזה מותר
    // רק לאדמין. לכן תלמידה קיבלה קישור הפניה בלי שום דרך לדעת אם
    // הוא עבד. פתיחת profiles לתלמידות הייתה חושפת את רשימת החברות,
    // ולכן כאן יושבת רשומה רזה שמכילה רק את הקוד המפנה.
    //
    // הקוד הוא 8 התווים הראשונים של ה-uid של המפנה, ולכן כל אחת
    // קוראת אך ורק את ההפניות שלה. שאילתה שאינה מסוננת לפי הקוד שלה
    // תיחסם על ידי הכלל הזה.
    match /referrals/{rid} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.code == request.auth.uid[0:8]);

      // נוצר פעם אחת, על ידי המצטרפת עצמה, ברגע ההרשמה.
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.code is string
                    && request.resource.data.code.size() >= 4
                    && request.resource.data.code.size() <= 32
                    && request.resource.data.code != request.auth.uid[0:8];

      // אין עריכה ואין מחיקה עצמית. ספירה שאפשר לשנות היא חסרת ערך.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- דיווח על תגובה ----------
    // תלמידה מדווחת, ורק אוריאן רואה. אין "כמה דיווחים קיבלת" בממשק
    // התלמידות, כדי שלא ייווצר כלי לחץ חברתי.
    // הדיווח שומר עותק של נוסח התגובה, כדי שאוריאן תדע על מה מדובר
    // גם אם הכותבת מחקה אותה בינתיים.
    match /reports/{rid} {
      allow read: if isAdmin();

      allow create: if hasAccess()
                    && request.resource.data.reporterUid == request.auth.uid
                    && request.resource.data.commentId is string
                    && request.resource.data.commentBody is string
                    && request.resource.data.commentBody.size() < 1200
                    && request.resource.data.handled == false;

      // רק אוריאן מסמנת כטופל או מוחקת. מדווחת לא חוזרת בה.
      allow update, delete: if isAdmin();
    }

    // ---------- חיובים וחשבוניות ----------
    // כל חיוב נשמר תחת המשתמש שלו. כרגע רק מנהל כותב (ידנית / מהוובהוק
    // של הסליקה בעתיד). המשתמש רואה רק את החיובים של עצמו.
    match /billing/{uid}/invoices/{invoiceId} {
      allow read: if request.auth.uid == uid || isAdmin();
      allow write: if isAdmin();
    }

    // ---------- ברירת מחדל: חסום ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
